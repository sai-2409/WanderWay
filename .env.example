# Environment Variables for WanderWay
# Copy this file to .env and add your actual values
# DO NOT commit real API keys to version control

# Resend (https://resend.com) — booking emails
RESEND_API_KEY=re_your_api_key_here

# From address must use a verified domain in Resend
# Format: "WanderWay <booking@yourdomain.com>" or booking@yourdomain.com
EMAIL_FROM=WanderWay <booking@wanderway-industry.org>

# Business inbox — receives new booking alerts
EMAIL_TO=your_business_email@gmail.com

# Optional: server port (default 5000)
# PORT=5000

# Render: add RESEND_API_KEY, EMAIL_FROM, and EMAIL_TO in the dashboard
