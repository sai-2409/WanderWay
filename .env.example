# Environment Variables for WanderWay
# Copy this file to .env and add your actual values
# DO NOT commit real API keys to version control

# SendGrid Configuration (Required for email functionality)
SENDGRID_API_KEY_WANDERWAY=your_sendgrid_api_key_here
SENDGRID_FROM=your_verified_sender_email@domain.com
SENDGRID_TO=your_business_email@domain.com

# Optional: Enable sandbox mode for testing (set to 1 to enable)
# SENDGRID_SANDBOX=0

# Production Notes:
# 1. Get your SendGrid API key from https://app.sendgrid.com/settings/api_keys
# 2. Verify your sender email in SendGrid before using
# 3. For Render deployment, add these as environment variables in the dashboard
